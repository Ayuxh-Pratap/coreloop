  {
    "id": "host",
    "note": "Held out (written 2026-10-04 after the day-2 fixes, before running them). coreloop runs in Windows Terminal, which takes the focus back after every turn.",
    "desktop": {
      "open": [
        "Terminal",
        "Spotify",
        "Brave"
      ],
      "foreground": "Spotify",
      "host": "Terminal"
    },
    "turns": [
      {
        "said": "Search for Karan Aujla.",
        "expect": {
          "operation": "spotify.search",
          "query": "karan aujla"
        },
        "note": "Spotify is the app in use under the terminal"
      },
      {
        "said": "Switch to Brave.",
        "expect": {
          "operation": "focus_app",
          "app": "Brave"
        }
      },
      {
        "said": "New tab.",
        "expect": {
          "operation": "browser.tab_new",
          "app": "Brave"
        }
      },
      {
        "said": "Search for the weather.",
        "expect": {
          "operation": "browser.search",
          "query": "the weather",
          "app": "Brave"
        }
      },
      {
        "said": "Maximize it.",
        "expect": {
          "operation": "window.maximize"
        }
      },
      {
        "said": "Open a new tab in the terminal.",
        "expect": {
          "operation": "terminal.tab_new"
        },
        "note": "named, so the host itself is fine"
      }
    ]
  },
  {
    "id": "typing",
    "note": "Held out (written 2026-10-04 after the day-2 fixes, before running them).",
    "desktop": {
      "open": [
        "Claude",
        "Terminal",
        "Cursor"
      ],
      "foreground": "Claude"
    },
    "turns": [
      {
        "said": "Type let's refactor the parser.",
        "expect": {
          "operation": "type_text",
          "span": "let's refactor the parser"
        }
      },
      {
        "said": "Type git status in the terminal.",
        "expect": {
          "operation": "type_text",
          "span": "git status",
          "app": "Terminal"
        }
      },
      {
        "said": "Type npm test and run it.",
        "expect": {
          "operation": "type_text",
          "span": "npm test",
