[
  {
    "id": "github-morning",
    "note": "Everyday developer flows on the simulated desktop with the simulated browser inside Brave. Generic, written before the first run. Checking a repo's issues first thing, then back to the editor.",
    "desktop": {
      "open": [
        "Brave",
        "Visual Studio Code",
        "Terminal",
        "Spotify"
      ],
      "foreground": "Brave"
    },
    "browser": {
      "page": "github-repo",
      "app": "Brave"
    },
    "turns": [
      {
        "said": "open the issues tab",
        "expect": {
          "operation": "page.click",
          "item_label": "Issues 1.1k",
          "surface": "browser"
        }
      },
      {
        "said": "scroll down a bit",
        "expect": {
          "operation": "page.scroll",
          "amount": "little",
          "surface": "browser"
        }
      },
      {
        "said": "click the bolt dev server issue",
        "expect": {
          "operation": "page.click",
          "item_label": "~Bolt dev server causes first navigation",
          "surface": "browser"
        }
      },
      {
        "said": "go back",
        "expect": {
          "operation": "page.back",
          "surface": "browser"
        }
      },
      {
        "said": "show me the closed issues",
        "expect": {
          "operation": "page.click",
          "item_label": "~Closed 24,436",
          "surface": "browser"
        }
      },
      {
        "said": "open pull requests",
        "expect": {
          "operation": "page.click",
          "item_label": "Pull requests",
          "surface": "browser"
        }
      },
      {
        "said": "switch to vs code",
        "expect": {
          "operation": "focus_app",
          "app": "Visual Studio Code",
          "surface": "desktop"
        }
      },
      {
        "said": "go back to brave",
        "expect": {
          "operation": "focus_app",
          "app": "Brave",
          "surface": "desktop"
        }
      }
    ]
  },
  {
    "id": "search-and-read",
    "note": "Searching the web for a tutorial and opening results.",
    "desktop": {
      "open": [
        "Brave",
        "Visual Studio Code",
        "Terminal",
        "Spotify"
      ],
      "foreground": "Brave"
    },
    "browser": {
      "page": "example",
      "app": "Brave"
    },
    "turns": [
      {
        "said": "search for lumen app router tutorial",
        "expect": {
          "operation": "search_web",
          "span": "lumen app router tutorial",
          "surface": "browser"
        }
      },
      {
        "said": "click the first result",
        "expect": {
          "operation": "page.click",
          "item_label": "~Routing: Getting Started",
          "surface": "browser"
        }
      },
      {
        "said": "go back",
        "expect": {
          "operation": "page.back",
          "surface": "browser"
        }
      },
      {
        "said": "open the devs for devs one",
        "expect": {
          "operation": "page.click",
          "item_label": "~DevsForDevs",
          "surface": "browser"
        }
      },
      {
        "said": "go back",
        "expect": {
          "operation": "page.back",
          "surface": "browser"
        }
      },
      {
        "said": "click the second result",
        "expect": {
          "operation": "page.click",
          "item_label": "The Router - Lumen",
          "surface": "browser"
        }
      },
      {
        "said": "open a new tab",
        "expect": {
          "operation": "page.tab_new",
          "surface": "browser"
        }
      },
      {
        "said": "go to github dot com",
        "expect": {
          "operation": "open_url",
          "url": "~github.com",
          "surface": "browser"
        }
      }
    ]
  },
