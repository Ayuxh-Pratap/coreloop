  {
    "id": "music-while-browsing",
    "note": "YouTube in the browser, Spotify on the desktop.",
    "desktop": {
      "open": [
        "Brave",
        "Visual Studio Code",
        "Terminal",
        "Spotify"
      ],
      "foreground": "Brave"
    },
    "browser": {
      "page": "youtube-lofi",
      "app": "Brave"
    },
    "turns": [
      {
        "said": "play the first video",
        "expect": {
          "operation": "page.click",
          "item_label": "~2 A.M Coding Session",
          "surface": "browser"
        }
      },
      {
        "said": "pause",
        "expect": {
          "operation": "media",
          "media": "play_pause",
          "surface": "desktop"
        }
      },
      {
        "said": "turn it up",
        "expect": {
          "operation": "media",
          "media": "volume_up",
          "surface": "desktop"
        }
      },
      {
        "said": "open spotify",
        "expect": {
          "operation": "open_app|focus_app",
          "app": "Spotify",
          "surface": "desktop"
        }
      },
      {
        "said": "search for lofi beats",
        "expect": {
          "operation": "spotify.search",
          "query": "lofi beats",
          "surface": "desktop"
        }
      },
      {
        "said": "next song",
        "expect": {
          "operation": "media",
          "media": "next",
          "surface": "desktop"
        }
      },
      {
        "said": "switch back to the browser",
        "expect": {
          "operation": "focus_app|open_app",
          "app": "Brave",
          "surface": "desktop"
        }
      },
      {
        "said": "go back",
        "expect": {
          "operation": "page.back",
          "surface": "browser"
        }
      }
    ]
  },
  {
    "id": "localhost-dev",
    "note": "Working on my own app on localhost, with the terminal.",
    "desktop": {
      "open": [
        "Brave",
        "Visual Studio Code",
        "Terminal",
        "Spotify"
      ],
      "foreground": "Brave"
    },
    "browser": {
      "page": "localhost-dashboard",
      "app": "Brave"
    },
    "turns": [
      {
        "said": "open settings",
        "expect": {
          "operation": "page.click",
          "item_label": "Settings",
          "surface": "browser"
        },
        "note": "the page's Settings link, not the Windows Settings app"
      },
      {
        "said": "go to projects",
        "expect": {
          "operation": "page.click",
          "item_label": "Projects",
          "surface": "browser"
        }
      },
      {
        "said": "click mobile app",
        "expect": {
          "operation": "page.click",
          "item_label": "Mobile app",
          "surface": "browser"
        }
      },
      {
        "said": "type new onboarding flow into the description",
        "expect": {
          "operation": "page.type_into",
          "item_label": "Description",
          "span": "new onboarding flow",
          "surface": "browser"
        }
      },
      {
        "said": "save changes",
        "expect": {
          "operation": "page.click",
          "item_label": "Save changes",
          "surface": "browser"
        }
      },
      {
        "said": "delete project",
        "expect": {
          "decision": "confirm",
          "operation": "page.click",
          "item_label": "Delete project",
          "surface": "browser"
        }
      },
      {
        "said": "cancel",
        "expect": {
          "decision": "ignore"
        }
      },
      {
        "said": "switch to the terminal",
        "expect": {
          "operation": "focus_app",
          "app": "Terminal",
          "surface": "desktop"
        }
      },
      {
        "said": "type npm run dev",
        "expect": {
          "operation": "type_text",
          "span": "npm run dev",
          "surface": "desktop"
        }
      },
      {
        "said": "press enter",
        "expect": {
          "operation": "press_key",
          "key": "enter",
          "surface": "desktop"
        }
      },
      {
        "said": "go back to brave",
        "expect": {
          "operation": "focus_app",
          "app": "Brave",
          "surface": "desktop"
        }
      },
      {
        "said": "refresh the page",
        "expect": {
          "operation": "page.reload",
          "surface": "browser"
        }
      }
    ]
  },
