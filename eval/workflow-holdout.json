[
  {
    "id": "pr-review",
    "note": "Held-out everyday flows: written after the fixes from eval/workflow.json, run once, blind. Looking around a repo before reviewing.",
    "desktop": {
      "open": [
        "Brave",
        "Visual Studio Code",
        "Terminal",
        "Spotify"
      ],
      "foreground": "Brave"
    },
    "browser": {
      "page": "github-repo",
      "app": "Brave"
    },
    "turns": [
      {
        "said": "go to the pull requests",
        "expect": {
          "operation": "page.click",
          "item_label": "~Pull requests",
          "surface": "browser"
        }
      },
      {
        "said": "back",
        "expect": {
          "operation": "page.back",
          "surface": "browser"
        }
      },
      {
        "said": "open the docs folder",
        "expect": {
          "operation": "page.click",
          "item_label": "docs, (Directory)",
          "surface": "browser"
        }
      },
      {
        "said": "go back",
        "expect": {
          "operation": "page.back",
          "surface": "browser"
        }
      },
      {
        "said": "click on discussions",
        "expect": {
          "operation": "page.click",
          "item_label": "Discussions",
          "surface": "browser"
        }
      },
      {
        "said": "go back",
        "expect": {
          "operation": "page.back",
          "surface": "browser"
        }
      },
      {
        "said": "take me to the releases",
        "expect": {
          "operation": "page.click",
          "item_label": "Releases",
          "surface": "browser"
        }
      },
      {
        "said": "open terminal",
        "expect": {
          "operation": "open_app|focus_app",
          "app": "Terminal",
          "surface": "desktop"
        }
      }
    ]
  },
  {
    "id": "learning",
