      {
        "said": "go back",
        "expect": {
          "operation": "page.back",
          "surface": "browser"
        }
      },
      {
        "said": "the third result",
        "expect": {
          "operation": "page.click",
          "item_label": "~Step-by-Step Guide for Beginners",
          "surface": "browser"
        }
      }
    ]
  },
